#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>
#include <unistd.h>

void *thread_function(void *arg) {
    char *name = (char*)arg;
    for(int i = 1; i <= 3; i++) {
        printf("[%s] Executing step %d...
", name, i);
        sleep(1);
    }
    printf("[%s] Finished execution.
", name);
    pthread_exit(NULL);
}

int main() {
    pthread_t t1, t2;
    printf("Main: Creating Thread 1 and Thread 2...

");
    
    pthread_create(&t1, NULL, thread_function, (void*)"Thread 1");
    pthread_create(&t2, NULL, thread_function, (void*)"Thread 2");
    
    pthread_join(t1, NULL);
    pthread_join(t2, NULL);
    
    printf("
Main: Both threads successfully completed. Exiting.
");
    return 0;
}
