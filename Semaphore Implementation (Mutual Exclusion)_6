#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <semaphore.h>
#include <sys/mman.h>
#include <sys/wait.h>

int main() {
    sem_t *sem = mmap(NULL, sizeof(sem_t), PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0);
    sem_init(sem, 1, 1);

    if(fork() == 0) {
        sem_wait(sem);
        printf("[CHILD] Entered Critical Section.
");
        sleep(2);
        printf("[CHILD] Leaving Critical Section.
");
        sem_post(sem);
        exit(0);
    }
    
    sem_wait(sem);
    printf("[PARENT] Entered Critical Section.
");
    sleep(2);
    printf("[PARENT] Leaving Critical Section.
");
    sem_post(sem);

    wait(NULL);
    sem_destroy(sem);
    return 0;
}
