#include <stdio.h>

int main() {
    int pageTable[50], pageSize, numPages, logicalAddress;
    int pageNumber, offset, frameNumber, physicalAddress, i;

    printf("--- PAGING TECHNIQUE: ADDRESS TRANSLATION ---
");
    printf("Enter Page Size (Bytes): "); 
    scanf("%d", &pageSize);
    printf("Enter Number of Pages: "); 
    scanf("%d", &numPages);

    printf("
Enter Frame Numbers for Each Page in Page Table:
");
    for(i = 0; i < numPages; i++) {
        printf("Page %d -> Frame: ", i);
        scanf("%d", &pageTable[i]);
    }

    printf("
Enter Logical Address to Translate: "); 
    scanf("%d", &logicalAddress);

    pageNumber = logicalAddress / pageSize;
    offset = logicalAddress % pageSize;

    if(pageNumber >= numPages) {
        printf("
Error: Logical Address exceeds allocated page range!
");
        return 0;
    }

    frameNumber = pageTable[pageNumber];
    physicalAddress = (frameNumber * pageSize) + offset;

    printf("
=== TRANSLATION DETAILS ===
");
    printf("Logical Address  : %d
", logicalAddress);
    printf("Page Number      : %d
", pageNumber);
    printf("Offset           : %d
", offset);
    printf("Mapped Frame     : %d
", frameNumber);
    printf("Physical Address : %d
", physicalAddress);
    return 0;
}
