#include <stdio.h>

int main() {
    int n, m, i, j, k;
    int allocation[10][10], max[10][10], need[10][10], available[10];
    int finish[10] = {0}, safeSeq[10], count = 0;
    
    printf("--- BANKER'S DEADLOCK AVOIDANCE ALGORITHM ---
");
    printf("Enter Number of Processes: "); 
    scanf("%d", &n);
    printf("Enter Number of Resources: "); 
    scanf("%d", &m);
    
    printf("
Enter Allocation Matrix (%dx%d):
", n, m);
    for(i = 0; i < n; i++)
        for(j = 0; j < m; j++) 
            scanf("%d", &allocation[i][j]);
            
    printf("
Enter Maximum Matrix (%dx%d):
", n, m);
    for(i = 0; i < n; i++)
        for(j = 0; j < m; j++) 
            scanf("%d", &max[i][j]);
            
    printf("
Enter Available Resources vector (%d values):
", m);
    for(i = 0; i < m; i++) 
        scanf("%d", &available[i]);
        
    // Compute Need Matrix
    for(i = 0; i < n; i++)
        for(j = 0; j < m; j++) 
            need[i][j] = max[i][j] - allocation[i][j];
            
    printf("
Calculated Need Matrix:
");
    for(i = 0; i < n; i++) {
        printf("P%d: ", i);
        for(j = 0; j < m; j++) printf("%d ", need[i][j]);
        printf("
");
    }
            
    while(count < n) {
        int found = 0;
        for(i = 0; i < n; i++) {
            if(finish[i] == 0) {
                for(j = 0; j < m; j++) {
                    if(need[i][j] > available[j]) break;
                }
                if(j == m) {
                    for(k = 0; k < m; k++) available[k] += allocation[i][k];
                    safeSeq[count++] = i;
                    finish[i] = 1;
                    found = 1;
                }
            }
        }
        if(found == 0) {
            printf("
System is NOT in Safe State (Deadlock condition detected)!
");
            return 0;
        }
    }
    
    printf("
Status: System is in a SAFE STATE.
Safe Sequence: ");
    for(i = 0; i < n; i++) {
        printf("P%d%s", safeSeq[i], (i == n - 1) ? "
" : " -> ");
    }
    return 0;
}
