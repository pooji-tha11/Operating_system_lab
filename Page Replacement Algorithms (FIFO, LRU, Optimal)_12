**fifo**
#include <stdio.h>

int main() {
    int pages[50], frames[10], n, f, i, j, k = 0, fault = 0, found;
    
    printf("--- FIFO PAGE REPLACEMENT ---
");
    printf("Enter Number of Pages: "); scanf("%d", &n);
    printf("Enter Reference String:
");
    for(i = 0; i < n; i++) scanf("%d", &pages[i]);
    printf("Enter Number of Frames: "); scanf("%d", &f);
    for(i = 0; i < f; i++) frames[i] = -1;

    for(i = 0; i < n; i++) {
        found = 0;
        for(j = 0; j < f; j++) {
            if(frames[j] == pages[i]) { found = 1; break; }
        }
        if(found == 0) {
            frames[k] = pages[i];
            k = (k + 1) % f;
            fault++;
        }
    }
    printf("
Total Page Faults (FIFO) = %d
", fault);
    return 0;
}


**lru**
#include <stdio.h>

int main() {
    int pages[50], frames[10], time[10], n, f, i, j, fault = 0, count = 0, found, pos, min;
    
    printf("--- LRU PAGE REPLACEMENT ---
");
    printf("Enter Number of Pages: "); scanf("%d", &n);
    printf("Enter Reference String:
");
    for(i = 0; i < n; i++) scanf("%d", &pages[i]);
    printf("Enter Number of Frames: "); scanf("%d", &f);
    for(i = 0; i < f; i++) frames[i] = -1;

    for(i = 0; i < n; i++) {
        found = 0;
        for(j = 0; j < f; j++) {
            if(frames[j] == pages[i]) {
                count++;
                time[j] = count;
                found = 1;
                break;
            }
        }
        if(found == 0) {
            min = time[0]; pos = 0;
            for(j = 0; j < f; j++) {
                if(frames[j] == -1) { pos = j; break; }
                if(time[j] < min) { min = time[j]; pos = j; }
            }
            frames[pos] = pages[i];
            count++;
            time[pos] = count;
            fault++;
        }
    }
    printf("
Total Page Faults (LRU) = %d
", fault);
    return 0;
}

**optimal**
#include <stdio.h>

int main() {
    int pages[50], frames[10], n, f, i, j, k, pos, fault = 0, found;
    
    printf("--- OPTIMAL PAGE REPLACEMENT ---
");
    printf("Enter Number of Pages: "); scanf("%d", &n);
    printf("Enter Reference String:
");
    for(i = 0; i < n; i++) scanf("%d", &pages[i]);
    printf("Enter Number of Frames: "); scanf("%d", &f);
    for(i = 0; i < f; i++) frames[i] = -1;

    for(i = 0; i < n; i++) {
        found = 0;
        for(j = 0; j < f; j++) {
            if(frames[j] == pages[i]) { found = 1; break; }
        }
        if(found == 0) {
            int emptyFrame = -1;
            for(j = 0; j < f; j++) {
                if(frames[j] == -1) { emptyFrame = j; break; }
            }
            if(emptyFrame != -1) {
                frames[emptyFrame] = pages[i];
            } else {
                int farthest = i + 1, replaceIdx = -1;
                for(j = 0; j < f; j++) {
                    int nextRef = 9999;
                    for(k = i + 1; k < n; k++) {
                        if(frames[j] == pages[k]) { nextRef = k; break; }
                    }
                    if(nextRef > farthest) {
                        farthest = nextRef;
                        replaceIdx = j;
                    }
                }
                if(replaceIdx == -1) replaceIdx = 0;
                frames[replaceIdx] = pages[i];
            }
            fault++;
        }
    }
    printf("
Total Page Faults (Optimal) = %d
", fault);
    return 0;
}
